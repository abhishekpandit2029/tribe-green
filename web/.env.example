# Copy to .env.local. Keep DATABASE_URL server-side only.
NEXT_PUBLIC_SITE_URL=https://your-website.vercel.app
DATABASE_URL=----
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional; if omitted, DATABASE_URL signs the admin session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
